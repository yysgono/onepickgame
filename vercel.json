{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "redirects": [
    {
      "source": "/quiz/:path*",
      "destination": "/ko/quiz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "onepickgame.com"
        }
      ],
      "destination": "https://www.onepickgame.com/:path*",
      "permanent": true
    },
    {
      "source": "/(ar|bn|de|es|fr|hi|id|ja|ko|pt|ru|th|tr|vi|zh)/notice",
      "destination": "/en/notice",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/en/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/en/terms-of-service",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap-quizzes.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap_index-v2.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemaps/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/sitemap-blog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/ads\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/auth/callback/?$",
      "dest": "/seo-shell.html"
    },
    {
      "src": "/suggestions-board/?$",
      "dest": "/server.js?seo=private-page&lang=en&page=suggestions-board"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/(notices|community)/?$",
      "dest": "/server.js?seo=community-list&lang=$1&board=$2"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/(my-worldcups|admin-suggestions|suggestions|suggestions-board|blog/write|blog/[^/]+/edit)/?$",
      "dest": "/server.js?seo=private-page&lang=$1&page=$2"
    },
    {
      "src": "/seo-shell[.]html",
      "dest": "/seo-shell.html"
    },
    {
      "src": "/api/worldcup-seo-image",
      "dest": "/server.js"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/category/([^/]+)/?$",
      "dest": "/server.js?seo=category&lang=$1&category=$2"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/random-pick/?$",
      "dest": "/server.js?seo=random-pick&lang=$1"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/random-pick/(delivery-food|snacks|dessert|movies|anime|countries|lotto645|lol-champions|travel-korea|travel-global)/?$",
      "dest": "/server.js?seo=random-pick&lang=$1&mode=$2"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/random-pick/(wheel|lotto|pinball|ladder|boxes|cards|order|dice|teams)/?$",
      "dest": "/server.js?seo=random-pick&lang=$1&mode=$2"
    },
    {
      "src": "/sitemap-quizzes[.]xml",
      "dest": "/server.js?seo=quiz-sitemap"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/?$",
      "dest": "/server.js?seo=home&lang=en"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/?$",
      "dest": "/server.js?seo=home&lang=$1"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/blog/?$",
      "dest": "/server.js?seo=blog-list&lang=$1"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/blog/([^/]+)/?$",
      "dest": "/server.js?seo=blog-post&lang=$1&slug=$2"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/select-round/([^/]+)/?$",
      "dest": "/server.js?seo=worldcup&lang=$1&id=$2"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/tier-list/?$",
      "dest": "/server.js?seo=tier-list-list&lang=$1"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/tier-list/create/?$",
      "dest": "/"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/tier-list/create/([^/]+)/?$",
      "dest": "/"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/tier-list/([^/]+)/?$",
      "dest": "/server.js?seo=tier-list&lang=$1&id=$2"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/quiz/?$",
      "dest": "/server.js?seo=quiz-list&lang=$1"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/quiz/create/?$",
      "dest": "/server.js?seo=quiz-create&lang=$1"
    },
    {
      "src": "/(ko|en|ja|zh|ru|pt|es|fr|id|hi|de|vi|ar|bn|th|tr)/quiz/([^/]+)/?$",
      "dest": "/server.js?seo=quiz-detail&lang=$1&id=$2"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js?seo=spa&path=$1"
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true
}
